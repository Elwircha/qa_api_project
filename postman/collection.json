    {
      "name": "Authorisation without token",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 401\", () => {\r",
              "    pm.expect(pm.response.code).to.eql(401);\r",
              "});\r",
              "\r",
              "pm.test(\"Response contains error message\", () => {\r",
              "    pm.expect(pm.response.json().message).to.have.length.above(0);\r",
              "})"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "pm.environment.unset(\"accessToken\");",
              "pm.environment.unset(\"refreshToken\");",
              "pm.globals.unset(\"accessToken\");",
              "pm.globals.unset(\"refreshToken\");",
              "",
              "const jar = pm.cookies.jar();",
              "jar.clear('https://dummyjson.com', function(err) {",
              "    if (err) {",
              "        console.log('Error clearing cookies:', err);",
              "    } else {",
              "        console.log('Cookies cleared successfully');",
              "    }",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
